{%- style -%}
  #shopify-section-{{ section.id }} .ultra-editorial {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .ultra-editorial__inner {
    width: min(
      calc(100% - 40px),
      {{ section.settings.content_width }}px
    );
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .ultra-editorial--center {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .ultra-editorial--left {
    text-align: left;
  }

  #shopify-section-{{ section.id }} .ultra-editorial__eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0277ff;
  }

  #shopify-section-{{ section.id }} .ultra-editorial__heading {
    max-width: 760px;
    margin: 0;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(38px, 4.2vw, 66px);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  #shopify-section-{{ section.id }} .ultra-editorial--center
  .ultra-editorial__heading {
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .ultra-editorial__text {
    max-width: 620px;
    margin-top: 24px;
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.68);
  }

  #shopify-section-{{ section.id }} .ultra-editorial--center
  .ultra-editorial__text {
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .ultra-editorial__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ultra-editorial__link {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 27px;

    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;

    color: rgb(var(--color-foreground));
    text-decoration: none;

    border-bottom: 1px solid rgba(2, 119, 255, 0.55);
    padding-bottom: 7px;

    transition:
      color 180ms ease,
      border-color 180ms ease,
      gap 180ms ease;
  }

  #shopify-section-{{ section.id }} .ultra-editorial__arrow {
    color: #0277ff;
    font-size: 18px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .ultra-editorial__link:hover {
    color: #0277ff;
    border-color: #0277ff;
    gap: 21px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ultra-editorial {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .ultra-editorial__inner {
      width: calc(100% - 40px);
    }

    #shopify-section-{{ section.id }} .ultra-editorial__eyebrow {
      margin-bottom: 12px;
      font-size: 10px;
    }

    #shopify-section-{{ section.id }} .ultra-editorial__heading {
      max-width: 100%;
      font-size: clamp(38px, 12vw, 52px);
      line-height: 0.98;
    }

    #shopify-section-{{ section.id }} .ultra-editorial__text {
      margin-top: 20px;
      font-size: 14px;
      line-height: 1.65;
    }

    #shopify-section-{{ section.id }} .ultra-editorial__link {
      margin-top: 24px;
      font-size: 10px;
    }
  }
{%- endstyle -%}


<section
  class="
    ultra-editorial
    color-{{ section.settings.color_scheme }}
    gradient
  "
>
  <div
    class="
      ultra-editorial__inner
      ultra-editorial--{{ section.settings.text_alignment }}
    "
  >

    {%- if section.settings.eyebrow != blank -%}
      <p class="ultra-editorial__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="ultra-editorial__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="ultra-editorial__text rte">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        class="ultra-editorial__link"
        {% if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {% else %}
          role="link"
          aria-disabled="true"
        {% endif %}
      >
        <span>{{ section.settings.button_label | escape }}</span>
        <span class="ultra-editorial__arrow" aria-hidden="true">→</span>
      </a>
    {%- endif -%}

  </div>
</section>


{% schema %}
{
  "name": "ULTRAMAISON — Editorial",
  "tag": "section",
  "class": "section ultra-editorial-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "ULTRAMAISON"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Una selección excepcional."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descripción",
      "default": "<p>Seleccionamos piezas que trascienden el tiempo. Diseño, precisión y carácter en perfecta armonía.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del enlace",
      "default": "Conoce nuestra filosofía"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 500,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo del contenido",
      "default": 760
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de colores",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaciado desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Espacio superior",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Espacio inferior",
      "default": 72
    },
    {
      "type": "header",
      "content": "Espaciado mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio superior mobile",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio inferior mobile",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "ULTRAMAISON — Editorial"
    }
  ]
}
{% endschema %}
